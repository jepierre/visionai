# Hugging Face model IDs
FALCON_HF_MODEL_ID=tiiuae/Falcon-Perception
GEMMA_HF_MODEL_ID=google/gemma-4-E4B-it

# CUDA device used by the smoke tests and future server.
CUDA_DEVICE=cuda:0

# Keep the Hugging Face cache inside this project only if desired. Uncomment and
# replace with an absolute path. Do not commit downloaded model weights.
# HF_HOME=E:\workspace\visionai\hf-cache
