# Falcon is still loaded from Hugging Face.
FALCON_HF_MODEL_ID=tiiuae/Falcon-Perception

# Local Ollama model used during Phase 0 validation.
# For host-run scripts on the same machine, use http://localhost:11434.
# If the app itself runs in another Docker container on the same Docker network,
# change this to http://ollama:11434.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# CUDA device used by the smoke tests and future server.
CUDA_DEVICE=cuda:0

# Optional: keep the Hugging Face cache inside this project only if you need to.
# Do not commit downloaded model weights.
# HF_HOME=/mnt/cloud/workspace/visionai/hf-cache
